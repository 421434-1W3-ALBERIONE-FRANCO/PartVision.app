# ==== Perfil activo ====
SPRING_PROFILES_ACTIVE=dev

# ==== Base de datos (PostgreSQL) ====
DB_URL=jdbc:postgresql://localhost:5442/partvision
DB_USERNAME=partvision
DB_PASSWORD=partvision

# ==== Object Storage (MinIO / S3) - se usa a partir de la Fase 6/7 ====
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=partvision-images

# ==== JWT - se usa a partir de la Fase 2 ====
# JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# JWT_EXPIRATION_MS=3600000

# ==== IA Vision (Fase 7) ====
# Por defecto AI_VISION_PROVIDER=stub (no llama a ninguna IA).
#
# — Opción A: Anthropic Claude —
# AI_VISION_PROVIDER=claude
# AI_VISION_MODEL=claude-opus-5   # o claude-haiku-4-5 para abaratar
# ANTHROPIC_API_KEY=sk-ant-...
#
# — Opción B: OpenAI GPT-4o —
# AI_VISION_PROVIDER=openai
# AI_VISION_MODEL=gpt-4o          # o gpt-4o-mini para abaratar
# OPENAI_API_KEY=sk-...
#
# — Opción C: Google Gemini (tiene nivel gratuito, key desde aistudio.google.com) —
# AI_VISION_PROVIDER=gemini
# AI_VISION_MODEL=gemini-flash-latest   # default recomendado (el free tier suele dar limit:0 en gemini-2.0-flash)
# GEMINI_API_KEY=AIza...

